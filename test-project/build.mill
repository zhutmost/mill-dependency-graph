//| mill-version: 1.1.9
//| mill-jvm-version: system

package build

import mill.*
import mill.scalalib.*

object core extends ScalaModule {
  def scalaVersion = "3.8.2"
  def mvnDeps = Seq(mvn"com.lihaoyi::pprint:0.9.0")
  def compileMvnDeps = Seq(mvn"org.jetbrains:annotations:26.0.2")
  def runMvnDeps = Seq(mvn"ch.qos.logback:logback-classic:1.5.18")
  def scalacPluginMvnDeps = Seq(mvn"org.scala-lang:scala3-compiler_3:3.8.2")

  object test extends ScalaTests, TestModule.Utest {
    def mvnDeps = Seq(mvn"com.lihaoyi::utest:0.8.9")
  }
}

object javaLib extends JavaModule {
  def mvnDeps = Seq(mvn"org.apache.commons:commons-text:1.12.0")
}

object consumer extends JavaModule {
  def moduleDeps = Seq(javaLib)
}

object excluded extends JavaModule {
  def mvnDeps = Seq(
    mvn"org.apache.commons:commons-text:1.12.0"
      .exclude("org.apache.commons" -> "commons-lang3")
  )
}

object withBom extends JavaModule {
  def bomMvnDeps = Seq(mvn"com.fasterxml.jackson:jackson-bom:2.17.2")
  def mvnDeps = Seq(mvn"com.fasterxml.jackson.core:jackson-databind")
}
